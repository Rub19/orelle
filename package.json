{
  "name": "orelle",
  "productName": "Orelle",
  "version": "0.7.5",
  "description": "Orelle — premium desktop experience layer for Windows 11 (Dock, top bar, launcher, widgets, control center, files, activity monitor, profiles).",
  "main": "dist/main.js",
  "private": true,
  "license": "UNLICENSED",
  "type": "commonjs",
  "scripts": {
    "build": "node scripts/build.mjs",
    "dev": "node scripts/build.mjs && electron . --orelle-dev",
    "start": "node scripts/build.mjs && electron .",
    "brand": "electron scripts/render-brand.cjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "smoke": "node scripts/build.mjs && electron . --orelle-smoke",
    "check": "npm run typecheck && npm test && npm run smoke",
    "dist": "node scripts/build.mjs && electron-builder --win nsis --x64 --publish never",
    "measure": "node scripts/build.mjs && electron . --orelle-measure",
    "release": "node scripts/build.mjs && electron-builder --win nsis --x64 --publish always",
    "verify-release": "node scripts/verify-release.mjs"
  },
  "dependencies": {
    "electron-updater": "6.8.10",
    "koffi": "3.3.3"
  },
  "devDependencies": {
    "@anthropic-ai/sdk": "0.133.0",
    "@types/node": "22.18.0",
    "electron": "44.9.3",
    "electron-builder": "26.17.0",
    "esbuild": "0.28.2",
    "typescript": "5.9.3",
    "vitest": "4.1.12"
  },
  "allowScripts": {
    "koffi@3.3.3": true,
    "esbuild@0.28.2": true,
    "electron@44.9.3": true
  },
  "author": "Rub19",
  "build": {
    "appId": "com.orelle.desktop",
    "productName": "Orelle",
    "artifactName": "Orelle-Setup-${version}.${ext}",
    "copyright": "© 2026 Orelle",
    "directories": {
      "output": "release",
      "buildResources": "resources/installer"
    },
    "files": [
      "dist/**/*",
      "package.json",
      "!dist/**/*.map"
    ],
    "asarUnpack": [
      "node_modules/koffi/**"
    ],
    "extraResources": [
      {
        "from": "resources/helpers",
        "to": "helpers"
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "resources/icons/orelle.ico",
      "requestedExecutionLevel": "asInvoker",
      "signAndEditExecutable": true
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowElevation": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Orelle",
      "uninstallDisplayName": "Orelle",
      "installerIcon": "resources/icons/orelle.ico",
      "uninstallerIcon": "resources/icons/orelle.ico",
      "deleteAppDataOnUninstall": false,
      "include": "resources/installer/installer.nsh"
    },
    "electronLanguages": [
      "fr",
      "en-US"
    ],
    "compression": "maximum",
    "publish": [
      {
        "provider": "github",
        "owner": "Rub19",
        "repo": "orelle",
        "releaseType": "release"
      }
    ]
  }
}
